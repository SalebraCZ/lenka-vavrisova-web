<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.nazev }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if page.url %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  <meta property="og:type" content="{% if nazev %}article{% else %}website{% endif %}">
  <meta property="og:locale" content="cs_CZ">
  <meta property="og:site_name" content="{{ site.nazev }}">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.nazev }} · {{ site.podtitul }}{% endif %}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  {% if page.url %}<meta property="og:url" content="{{ site.url }}{{ page.url }}">{% endif %}
  <meta property="og:image" content="{{ site.url }}/assets/og-obrazek.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23b0603f'/%3E%3C/svg%3E">
  <link rel="preload" href="/assets/fonts/lora-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
  {% set menu = [
    ["/provazeni/", "Provázení"],
    ["/workshop/", "Workshop"],
    ["/koucink/", "Koučink"],
    ["/profil/", "Profil"],
    ["/akce/", "Kde se potkáme"],
    ["/blog/", "Blog"],
    ["#kontakt", "Kontakt"]
  ] %}
  <header class="nav">
    <div class="wrap">
      <a class="logo" href="/">{{ site.nazev }}</a>
      <nav class="menu" aria-label="Hlavní navigace">
        {% for item in menu %}<a href="{{ item[0] }}"{% if page.url == item[0] %} aria-current="page"{% endif %}>{{ item[1] }}</a>{% endfor %}
      </nav>
      <details class="menu-mobile">
        <summary>Menu</summary>
        <nav aria-label="Navigace na mobilu">
          {% for item in menu %}<a href="{{ item[0] }}">{{ item[1] }}</a>{% endfor %}
        </nav>
      </details>
    </div>
  </header>
  <main>
    {{ content | safe }}
  </main>
  {% include "kontakt.njk" %}
  <footer>
    <div class="wrap">
      <span>© {{ site.nazev }}</span>
      <span>{{ site.podtitul }}</span>
    </div>
  </footer>
</body>
</html>
