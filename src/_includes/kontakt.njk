<section class="contact" id="kontakt">
  <div class="wrap">
    <div class="eyebrow">Kontakt</div>
    <h2>Začněme rozhovorem</h2>
    <p>Na úvodních 30 minutách zjistíme, co potřebujete, jestli jsem pro vás ta pravá, a domluvíme podmínky. Zdarma a nezávazně.</p>
    <a class="btn" href="{{ site.mailto }}">{{ site.rezervace }}</a>
    <div class="alt">
      Raději napíšete nebo zavoláte?<br>
      E-mail: <b><a href="mailto:{{ site.email }}">{{ site.email }}</a></b> · Telefon: <b><a href="{{ site.telefonOdkaz }}">{{ site.telefon }}</a></b> · Instagram: <b><a href="{{ site.instagram }}">{{ site.instagramJmeno }}</a></b>
    </div>
  </div>
</section>
